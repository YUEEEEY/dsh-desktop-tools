{
  "name": "dsh-desktop-tools",
  "version": "0.4.0",
  "description": "dsh 环境管理插件（TypeScript）：安装即自动配备桌面窗口宿主（Rust/Tauri，按系统下载或构建），运行时版本管理与一键更新、平台兼容自动适配、DeepSeek 官方计费面板，以及内置代码编辑器（工作区文件浏览/编辑）。",
  "type": "module",
  "main": "lib/index.js",
  "bin": {
    "dsh-desktop": "lib/bin.js"
  },
  "exports": {
    ".": "./lib/index.js"
  },
  "files": [
    "lib",
    "scripts",
    "cordis.patch.yml"
  ],
  "scripts": {
    "build": "tsc",
    "prepare": "tsc",
    "postinstall": "node scripts/ensure-host.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YUEEEEY/dsh-desktop-tools.git"
  },
  "bugs": {
    "url": "https://github.com/YUEEEEY/dsh-desktop-tools/issues"
  },
  "homepage": "https://github.com/YUEEEEY/dsh-desktop-tools#readme",
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0"
  }
}
