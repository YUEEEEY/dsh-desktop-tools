{
  "name": "dsh-desktop-tools",
  "version": "0.3.1",
  "description": "dsh 环境管理插件（TypeScript）：桌面窗口宿主（Rust/Tauri）管理、运行时版本管理与更新、Windows 补丁（win32 进程检查器 / minimal preset pwsh）、DeepSeek 计费与综合面板（/panel、/billing、/api/runtime、/api/patches、/api/desktop）。",
  "type": "module",
  "main": "lib/index.js",
  "bin": {
    "dsh-desktop": "lib/bin.js"
  },
  "exports": {
    ".": "./lib/index.js"
  },
  "files": [
    "lib",
    "cordis.patch.yml"
  ],
  "scripts": {
    "build": "tsc",
    "prepare": "tsc"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YUEEEEY/dsh-desktop-tools.git"
  },
  "bugs": {
    "url": "https://github.com/YUEEEEY/dsh-desktop-tools/issues"
  },
  "homepage": "https://github.com/YUEEEEY/dsh-desktop-tools#readme",
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0"
  }
}
